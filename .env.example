# Copy this file to .env and fill in real values. Never commit .env.
# See README.md "Setup" for where each of these comes from.

# --- Database (Supabase Postgres via Prisma) -------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# DATABASE_URL: the "Transaction pooler" string (port 6543), used by the
# running app — add ?pgbouncer=true if your Supabase project's string
# doesn't already include it.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: the "Direct connection" string (port 5432), used only by
# Prisma Migrate / `prisma db push`.
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Realtime -------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL="https://xxxxx.supabase.co"
# The "service_role" secret key — server-only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# Public values, safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# The "anon" / "public" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# --- Moderation & maintenance -------------------------------------------------
# Any long random string. Sent as the `x-admin-secret` header to /api/admin/*.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Any long random string. Sent as `Authorization: Bearer <value>` to
# /api/cron/cleanup.
CRON_SECRET="change-me-to-a-different-long-random-string"

# Optional. Days of message history to keep. Defaults to 30 if unset.
RETENTION_DAYS="30"
